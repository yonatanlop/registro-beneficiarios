# Variables para docker-compose (pruebas locales con Postgres en contenedor).
# Copia este archivo como ".env" y cambia los valores antes de usarlo en
# cualquier entorno que no sea tu propia maquina de desarrollo.

# Usuario, clave y nombre de la base de datos Postgres local
PG_USER=registro
PG_PASSWORD=CambiarClaveAppDb123
PG_DATABASE=registro

# Secreto para firmar las cookies de sesion de Express
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# Usuario administrador inicial del panel (se crea solo la primera vez)
ADMIN_USER=admin
ADMIN_PASSWORD=CambiarEstaClave123

# --- Produccion (Render + Neon) ---
# En Render, en vez de este archivo, estas variables se configuran como
# "Environment Variables" del servicio. DATABASE_URL la da Neon directamente
# (Dashboard del proyecto -> Connection string). Ejemplo:
# DATABASE_URL=postgres://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require
