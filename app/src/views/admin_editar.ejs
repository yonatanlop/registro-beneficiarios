<%- include('partials/head', { titulo: 'Editar beneficiario - Registro de Beneficiarios' }) %>
<%- include('partials/nav') %>

<main>
  <div class="card">
    <p><a href="/admin">&laquo; Volver al listado</a></p>
    <h1>Editar beneficiario</h1>

    <% if (saved) { %>
      <div class="alerta exito">Datos actualizados correctamente.</div>
    <% } %>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alerta error"><%= errorMessage %></div>
    <% } %>

    <form action="/admin/beneficiarios/<%= id %>" method="post">
      <%- include('partials/form_campos', { FIELDS: FIELDS, values: values, showAdminFields: true }) %>
      <div class="acciones">
        <button type="submit">Guardar cambios</button>
        <a class="btn secundario" href="/admin">Cancelar</a>
      </div>
    </form>

    <form action="/admin/beneficiarios/<%= id %>/eliminar" method="post" class="form-eliminar"
          data-nombre="<%= values.nombres_apellidos %>" data-documento="<%= values.documento_identidad %>"
          style="margin-top:16px">
      <button type="submit" class="peligro">Eliminar este beneficiario</button>
    </form>
  </div>
</main>

<footer class="pie">Registro de Beneficiarios · Jornadas de Apoyo</footer>
<%- include('partials/confirmar_eliminar') %>
</body>
</html>
