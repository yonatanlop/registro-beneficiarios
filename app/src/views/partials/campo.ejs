<%
// Locals esperados: f (definicion del campo), values (objeto con valores actuales)
const val = values[f.key];
%>
<% if (f.type === 'bool') { %>
  <div class="checkitem">
    <input type="checkbox" id="<%= f.key %>" name="<%= f.key %>" <%= val ? 'checked' : '' %> />
    <label for="<%= f.key %>" style="font-weight:500"><%= f.label %></label>
  </div>
<% } else { %>
  <div class="campo">
    <label for="<%= f.key %>">
      <%= f.label %><% if (f.required) { %> <span class="req">*</span><% } %>
      <% if (f.configOnly) { %> <span class="candado" title="Definido desde Configuración, no editable aquí">🔒</span><% } %>
    </label>
    <% if (f.type === 'select') { %>
      <select id="<%= f.key %>" name="<%= f.key %>" <%= f.configOnly ? 'disabled' : '' %>>
        <option value="">--</option>
        <% f.options.forEach(function(opt) { %>
          <option value="<%= opt %>" <%= val === opt ? 'selected' : '' %>>
            <%= opt === 'F' ? 'Femenino' : (opt === 'M' ? 'Masculino' : opt) %>
          </option>
        <% }); %>
      </select>
    <% } else { %>
      <input
        type="<%= f.type %>"
        id="<%= f.key %>"
        name="<%= f.key %>"
        value="<%= val || '' %>"
        <%= f.required ? 'required' : '' %>
        <%= f.configOnly ? 'readonly' : '' %>
      />
    <% } %>
  </div>
<% } %>
