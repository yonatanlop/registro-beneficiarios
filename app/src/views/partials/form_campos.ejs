<%
const showAdminFields = typeof locals.showAdminFields !== 'undefined' && locals.showAdminFields;
const porGrupo = (g) => FIELDS.filter(f => f.group === g && (!f.adminOnly || showAdminFields));
%>

<h2 class="seccion">Datos del beneficiario</h2>
<div class="grid">
  <% porGrupo('persona').forEach(function(f) { %>
    <%- include('campo', { f: f, values: values }) %>
  <% }); %>
</div>

<h2 class="seccion">Discapacidad</h2>
<div class="grid">
  <div class="campo checks">
    <div class="checkrow">
      <% porGrupo('discapacidad').forEach(function(f) { %>
        <%- include('campo', { f: f, values: values }) %>
      <% }); %>
    </div>
  </div>
</div>

<h2 class="seccion">Datos de la jornada / evento</h2>
<div class="grid">
  <% porGrupo('jornada').forEach(function(f) { %>
    <%- include('campo', { f: f, values: values }) %>
  <% }); %>
</div>

<h2 class="seccion">Población atendida</h2>
<div class="grid">
  <div class="campo checks">
    <div class="checkrow">
      <% porGrupo('poblacion').forEach(function(f) { %>
        <%- include('campo', { f: f, values: values }) %>
      <% }); %>
    </div>
  </div>
</div>

<% if (showAdminFields && porGrupo('sistema').length > 0) { %>
  <h2 class="seccion">Estado del registro</h2>
  <div class="grid">
    <div class="campo checks">
      <div class="checkrow">
        <% porGrupo('sistema').forEach(function(f) { %>
          <%- include('campo', { f: f, values: values }) %>
        <% }); %>
      </div>
    </div>
  </div>
<% } %>
